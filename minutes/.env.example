# --- 必須（機能ごと） -------------------------------------------------
# 文字起こし + 話者分離（https://console.deepgram.com/ で発行。Member 以上の権限のキー）
DEEPGRAM_API_KEY=
# 要点・議事録の生成（https://console.anthropic.com/）
ANTHROPIC_API_KEY=
# Notion 保存（https://www.notion.so/profile/integrations で内部インテグレーションを作成）
NOTION_TOKEN=
# 保存先。データベースまたはページの URL / ID（そのページ・DBをインテグレーションに「接続」しておく）
NOTION_PARENT=

# --- 公開するとき（スマホから使うとき）は必ず設定 ----------------------
# 設定すると、アプリ初回起動時にこの合言葉を求めます。未設定のまま外部公開しないでください。
ACCESS_TOKEN=
# ローカルだけなら 127.0.0.1、LAN/クラウドで公開するなら 0.0.0.0
HOST=127.0.0.1
PORT=8787

# --- 任意 ---------------------------------------------------------------
MODEL_LIVE=claude-haiku-4-5-20251001
MODEL_FINAL=claude-sonnet-5-5
