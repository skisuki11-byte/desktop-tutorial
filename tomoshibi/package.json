    "@capacitor/status-bar": "^8.0.3",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "esbuild": "^0.28.2"
